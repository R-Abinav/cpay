# CPay backend (EC2) settings. Copy to deploy/.env (gitignored) and fill in:
#   cp backend.env.example .env && chmod 600 .env
# Names only here, never values. docker-compose.yml hands each service only the variables it needs.

# ---- Edge (Caddy) -----------------------------------------------------------------------------------
# Your domain: Caddy serves hub.<CPAY_DOMAIN>, relay.<CPAY_DOMAIN>, issuer.<CPAY_DOMAIN>, artifacts.<CPAY_DOMAIN>
CPAY_DOMAIN=
# Let's Encrypt account email (expiry notices only)
ACME_EMAIL=
# The Vercel web origin, exact, no trailing slash, e.g. https://cpay.vercel.app
# Used as HUB_ALLOWED_ORIGINS, ISSUER_ALLOWED_ORIGINS and the artifacts CORS origin.
WEB_ORIGIN=

# ---- Supabase Postgres (hub: glasses_units, issuer: nullifiers) -------------------------------------
# Pooler URL; append &connect_timeout=30&pool_timeout=30
DATABASE_URL=
# Direct URL (the Prisma schema requires it)
DIRECT_URL=

# ---- Glasses hub ------------------------------------------------------------------------------------
# >= 32 chars, the SAME value as HUB_TICKET_SECRET on Vercel (the web verifies the hub's tickets)
HUB_TICKET_SECRET=
# optional (defaults 300 / 3600)
HUB_PAIRING_CODE_TTL_SECONDS=
HUB_TICKET_TTL_SECONDS=

# ---- Relay ------------------------------------------------------------------------------------------
# optional: the issuer's BBS public key (base64). Empty = fetched from the issuer container.
ISSUER_BBS_PUBLIC_KEY=
# optional (defaults 20 / 60; a whole venue shares one NAT IP)
RELAY_MAX_CONNS_PER_IP=
RELAY_MAX_NEW_CONNS_PER_MIN_PER_IP=

# ---- Issuer -----------------------------------------------------------------------------------------
# staging (World simulator) or production
WORLD_ENVIRONMENT=
# Optional: every World environment /enrol accepts, e.g. production,staging (staging = World's simulator, for testing)
WORLD_ENVIRONMENTS=
# default cpay-recipient-v1; must match NEXT_PUBLIC_WORLD_ACTION on Vercel
WORLD_ACTION=
# rp_... from the World Developer Portal
WORLD_RP_ID=
# secret
WORLD_RP_SIGNING_KEY=
# secret: pnpm --filter @cpay/issuer keygen (keep the same key, or every issued card stops verifying)
ISSUER_BBS_SECRET_KEY=
