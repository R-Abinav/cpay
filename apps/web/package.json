{
  "name": "@cpay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "copy-ort": "node scripts/copy-ort.mjs",
    "dev": "node scripts/copy-ort.mjs && NEXT_TELEMETRY_DISABLED=1 next dev --webpack -p 3000",
    "dev:https": "node scripts/copy-ort.mjs && NEXT_TELEMETRY_DISABLED=1 next dev --webpack --experimental-https -H 0.0.0.0 -p 3000",
    "build": "node scripts/copy-ort.mjs && NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "axios": "1.7.2",
    "@cpay/credential": "workspace:*",
    "@cpay/database": "workspace:*",
    "@cpay/glasses-kit": "workspace:*",
    "@cpay/protocol": "workspace:*",
    "@cpay/railgun": "workspace:*",
    "@cpay/stealth": "workspace:*",
    "@cpay/wallet": "workspace:*",
    "@cpay/world": "workspace:*",
    "@cpay/zerog": "workspace:*",
    "@railgun-community/shared-models": "^8.2.1",
    "@railgun-community/wallet": "^11.3.0",
    "@worldcoin/idkit": "4.6.0",
    "jsqr": "1.4.0",
    "next": "^16.4.5",
    "onnxruntime-web": "1.31.1",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "snarkjs": "^0.7.6",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4"
  }
}
