{
  "name": "@cpay/glasses-kit",
  "version": "0.1.0",
  "description": "CPay glasses kit: ESP32-CAM firmware (PlatformIO) + glasses hub (Render) + provisioning",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./bridge/src/messages.ts",
    "./messages": "./bridge/src/messages.ts",
    "./bridge": "./bridge/src/bridge.ts",
    "./hub": "./hub/src/messages.ts",
    "./ticket": "./hub/src/ticket.ts"
  },
  "scripts": {
    "hub": "tsx hub/src/main.ts",
    "hub:sim": "tsx hub/src/sim.ts",
    "bridge": "tsx bridge/src/main.ts",
    "sim": "tsx bridge/src/sim.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fw:build": "$HOME/.platformio/penv/bin/pio run -d firmware -e cam",
    "provision": "$HOME/.platformio/penv/bin/python scripts/provision.py"
  },
  "dependencies": {
    "@cpay/database": "workspace:*",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
