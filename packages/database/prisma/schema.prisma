generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Issuer (cpay-issuer): one row per World-verified human (CLAUDE.md invariant 3). Exactly these three
// columns: no id, no timestamps (enrolment time would be a correlation handle), no IPs, no wallets.
// commitment_hash = sha256 of the BBS commitment C, so the same holder can be re-signed (new phone,
// same passkey) and a different holder for a used nullifier is refused. SQL: apps/issuer/migrations.
// The BBS issuer key and the World RP key are operational secrets in env, never in the database.
model Nullifier {
  nullifier      String // normalised decimal of the uint256 World nullifier
  action         String // e.g. "cpay-recipient-v1"
  commitmentHash String @map("commitment_hash")

  @@unique([nullifier, action], name: "nullifier_action_unique", map: "nullifiers_nullifier_action_key")
  @@map("nullifiers")
}

// Glasses hub (cpay-hub): which glasses unit is paired to which anonymous phone token.
// Only hashes: sha256(unit_secret) and sha256(owner_token). No IPs, no names, no wallets.
model GlassesUnit {
  unitId         String   @id @map("unit_id")
  unitSecretHash String   @map("unit_secret_hash")
  ownerTokenHash String?  @unique @map("owner_token_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("glasses_units")
}

// 0G evidence: one row per 0G call (STT, intent, TTS, storage upload). Public proof for 0G judges.
// IDs, receipt status, model names, hashes and the router trace ONLY. Never audio, transcript, prompt,
// completion text, addresses, IPs or ticket IDs (CLAUDE.md invariant 3).
model ZgEvidence {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now()) @map("created_at")
  kind                String   // stt | intent | tts | storage
  model               String
  trustMode           String   @map("trust_mode")
  requestId           String?  @map("request_id")
  providerResponseKey String?  @map("provider_response_key") // ZG-Res-Key header
  receiptSignature    String?  @map("receipt_signature")
  receiptStatus       String   @map("receipt_status") // verified | unverified | missing | error
  teeVerified         Boolean? @map("tee_verified")
  status              String   // ok | refused | error
  latencyMs           Int?     @map("latency_ms")
  rootHash            String?  @map("root_hash")
  trace               Json?    // x_0g_trace + 0G response headers + error/refusal codes only

  @@index([createdAt])
  @@map("zg_evidence")
}
