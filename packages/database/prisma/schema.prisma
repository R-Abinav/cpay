generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Stores used World ID nullifiers per action.
// Invariant #3: Backend stores ONLY used World ID nullifiers + issuer key.
// No faces, no wallets, no payment history, no IPs.
model Nullifier {
  id         String   @id @default(cuid())
  nullifier  String   // Decimal representation of the uint256 Semaphore nullifier hash
  action     String   // e.g. "cpay-recipient-v1"
  createdAt  DateTime @default(now())

  @@unique([nullifier, action], name: "nullifier_action_unique")
  @@index([nullifier])
}

// Stores active and historical BBS issuer public keys & epoch metadata.
model IssuerKey {
  id                  String   @id @default(cuid())
  keyType             String   @default("BBS_BLS12381")
  publicKey           String   // Base64 or hex encoded BBS+ public key
  epoch               String   // Format: YYYY-MM
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([active])
}

// Glasses hub (cpay-hub): which glasses unit is paired to which anonymous phone token.
// Only hashes: sha256(unit_secret) and sha256(owner_token). No IPs, no names, no wallets.
model GlassesUnit {
  unitId         String   @id @map("unit_id")
  unitSecretHash String   @map("unit_secret_hash")
  ownerTokenHash String?  @unique @map("owner_token_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("glasses_units")
}

// 0G evidence: one row per 0G call (STT, intent, TTS, storage upload). Public proof for 0G judges.
// IDs, receipt status, model names, hashes and the router trace ONLY. Never audio, transcript, prompt,
// completion text, addresses, IPs or ticket IDs (CLAUDE.md invariant 3).
model ZgEvidence {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now()) @map("created_at")
  kind                String   // stt | intent | tts | storage
  model               String
  trustMode           String   @map("trust_mode")
  requestId           String?  @map("request_id")
  providerResponseKey String?  @map("provider_response_key") // ZG-Res-Key header
  receiptSignature    String?  @map("receipt_signature")
  receiptStatus       String   @map("receipt_status") // verified | unverified | missing | error
  teeVerified         Boolean? @map("tee_verified")
  status              String   // ok | refused | error
  latencyMs           Int?     @map("latency_ms")
  rootHash            String?  @map("root_hash")
  trace               Json?    // x_0g_trace + 0G response headers + error/refusal codes only

  @@index([createdAt])
  @@map("zg_evidence")
}
