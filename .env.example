# CPay environment. Copy to .env (git-ignored) for local dev; set the same vars per service in Render.
# TESTNETS ONLY. Only NEXT_PUBLIC_* reaches the browser: NEVER put a secret in a NEXT_PUBLIC_* var.
# Server secrets below are OUR operational keys. No user key or user money ever lives on a server.

# ===========================================================================
# Shared
# ===========================================================================
# Supabase Postgres (pooled connection string). Server-side only; never in the browser.
DATABASE_URL=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres
# Shared by cpay-hub (issues tickets) and cpay-web (verifies them before spending 0G credits). 32+ random bytes, hex.
HUB_TICKET_SECRET=

# ===========================================================================
# cpay-web (apps/web): PWA + API routes
# ===========================================================================
# --- Public config (browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Passkey rpId = the PRODUCTION domain of cpay-web (e.g. cpay-web.onrender.com).
# Changing it changes every user's keys. Use localhost only for local throwaway wallets.
NEXT_PUBLIC_PASSKEY_RP_ID=localhost
# Base Sepolia. Payments on any other chain are rejected.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
# Circle testnet USDC on Base Sepolia (verified 6 Nov 2026 on developers.circle.com). Faucet: https://faucet.circle.com
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# ETH sent with each CPay-QR payment so the one-time address can move funds later (0.0001 ETH; Base gas is cheap)
NEXT_PUBLIC_GAS_DROP_WEI=100000000000000
# Default spend caps for new wallets (users can change them in Settings; raising needs Agent Pass)
NEXT_PUBLIC_DEFAULT_PAYMENT_CAP_USDC=5
NEXT_PUBLIC_DEFAULT_DAILY_CAP_USDC=15
NEXT_PUBLIC_ALLOWED_TOKENS=USDC
NEXT_PUBLIC_CLAIM_TIMEOUT_MS=6000
NEXT_PUBLIC_CONFIRM_TIMEOUT_MS=60000
NEXT_PUBLIC_HUB_URL=ws://localhost:8790
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787
NEXT_PUBLIC_ISSUER_URL=http://localhost:8788
# Ed25519 public key (hex) that signs Agent Pass approval tokens; the phone verifies with it
NEXT_PUBLIC_AGENT_PASS_APPROVAL_PUBLIC_KEY=
# World IDKit (recipient verification)
NEXT_PUBLIC_WORLD_APP_ID=app_
NEXT_PUBLIC_WORLD_ACTION=cpay-recipient-v1
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
# Face path (stretch)
NEXT_PUBLIC_FACE_MATCH_THRESHOLD=0.6

# --- World Agent Pass (OIDC step-up), server-side ---
# Sandbox: https://sandbox.auth.world.org   Production: https://auth.world.org
AGENT_PASS_ISSUER=https://sandbox.auth.world.org
AGENT_PASS_CLIENT_ID=
# Secret
AGENT_PASS_CLIENT_SECRET=
AGENT_PASS_REDIRECT_URI=http://localhost:3000/api/agent-pass/callback
# One value or a comma-separated list
AGENT_PASS_ACR=https://world.org/oidc/acr/orb
AGENT_PASS_APPROVAL_TTL_SECONDS=300
# Secret. Ed25519 private key (hex) that signs approval tokens
AGENT_PASS_APPROVAL_SECRET_KEY=

# --- 0G router (Private Computer), server-side. OpenAPI: https://0gfoundation.github.io/0g-router/ ---
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# Secret. Our 0G credits pay for every user's voice calls (per-user 0G accounts are roadmap)
ZG_ROUTER_API_KEY=sk-
# MODELS ARE CHOSEN BY THE TEAMMATE. Check private-mode providers with GET /v1/providers.
# 5 Nov: whisper-large-v3 private; glm-5.3 verified only (no private); 0gm-1.0-35b-a3b private.
ZG_STT_MODEL=whisper-large-v3
ZG_STT_TRUST_MODE=private
ZG_INTENT_MODEL=
ZG_INTENT_TRUST_MODE=private
# TTS (template text only). minimax-speech-* are standard-only.
ZG_TTS_MODEL=minimax-speech-2.8-turbo
ZG_TTS_VOICE=
ZG_TTS_TRUST_MODE=standard
ZG_TTS_FORMAT=mp3
# Ask 0G to verify the provider's TEE signature (x_0g_trace.tee_verified)
ZG_VERIFY_TEE=true
# Safe-stop if 0G doesn't answer within this many ms (private Whisper measured 12-28 s on 6 Nov)
ZG_TIMEOUT_MS=45000
# Requests per hub ticket per minute
ZG_RATE_LIMIT_PER_MIN=20

# --- 0G Storage (encrypted episodes), Galileo testnet. Faucet: https://faucet.0g.ai ---
ZG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# Secret. Throwaway Galileo key that pays upload gas (ours, not a user's)
ZG_STORAGE_PRIVATE_KEY=0x

# ===========================================================================
# cpay-hub (packages/glasses-kit hub): glasses <-> phone pairing + routing
# ===========================================================================
HUB_PORT=8790
# Browser origins allowed on /phone (the cpay-web origin)
HUB_ALLOWED_ORIGINS=http://localhost:3000
HUB_PAIRING_CODE_TTL_SECONDS=300
HUB_TICKET_TTL_SECONDS=3600

# ===========================================================================
# cpay-relay (apps/relay)
# ===========================================================================
RELAY_PORT=8787

# ===========================================================================
# cpay-issuer (apps/issuer): World verify + nullifiers + BBS cards
# ===========================================================================
ISSUER_PORT=8788
ISSUER_ALLOWED_ORIGINS=http://localhost:3000
WORLD_ENVIRONMENT=staging
WORLD_ACTION=cpay-recipient-v1
WORLD_RP_ID=rp_
# Secret. Used by signRequest from @worldcoin/idkit-core/signing
WORLD_RP_SIGNING_KEY=
# Secret. BBS issuer secret key (base64). Generate: pnpm --filter @cpay/issuer keygen
ISSUER_BBS_SECRET_KEY=

# ===========================================================================
# Local dev scripts only (never on Render)
# ===========================================================================
# Throwaway Base Sepolia key for `pnpm --filter @cpay/stealth pay` smoke tests. Not used by the app.
DEV_SMOKE_PRIVATE_KEY=0x
