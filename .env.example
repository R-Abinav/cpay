# CPay environment. Copy to .env (git-ignored) and fill in. TESTNETS ONLY.
# Rule: only NEXT_PUBLIC_* values reach the browser. Never put a secret in a NEXT_PUBLIC_* var.

# ---------------------------------------------------------------------------
# Chain: Ethereum Sepolia
# ---------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://sepolia.example-rpc.io/v2/<key>
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CHAIN_ID=11155111
# Circle testnet USDC (verified 5 Nov 2026). Faucet: https://faucet.circle.com
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# ETH sent with each lite payment so the one-time address can move funds later (0.0003 ETH)
GAS_DROP_WEI=300000000000000

# ---------------------------------------------------------------------------
# AGENT WALLET: the only wallet CPay pays from. A dedicated throwaway Sepolia EOA.
# Fund it with ~the daily cap in USDC + ~0.01 Sepolia ETH. NEVER your main wallet.
# Secret. Read ONLY by apps/web/app/api/pay (server) and the `pnpm --filter @cpay/stealth pay` script.
# Never NEXT_PUBLIC_*, never in a prompt, never logged.
# ---------------------------------------------------------------------------
AGENT_WALLET_PRIVATE_KEY=0x

# Policy engine (deterministic, server-side; the LLM never decides)
# Above the per-payment cap, or past the daily cap, needs a World Agent Pass approval
AGENT_PAYMENT_CAP_USDC=5
AGENT_DAILY_CAP_USDC=15
AGENT_ALLOWED_TOKENS=USDC
# Where the agent runtime keeps its spent-today ledger (payer laptop only)
AGENT_LEDGER_PATH=./data/agent-ledger.json
# Agent Pass approval lifetime (single-use, bound to {sessionId, amount, token})
AGENT_APPROVAL_TTL_SECONDS=300
# Display-only copies for the UI (not enforced in the browser)
NEXT_PUBLIC_AGENT_PAYMENT_CAP_USDC=5
NEXT_PUBLIC_AGENT_DAILY_CAP_USDC=15

# ---------------------------------------------------------------------------
# Relay (apps/relay)
# ---------------------------------------------------------------------------
RELAY_PORT=8787
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787

# ---------------------------------------------------------------------------
# World: IDKit 4 (recipient onboarding, Proof of Human)
# Developer Portal: https://developer.world.org  Simulator: https://simulator.worldcoin.org
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORLD_APP_ID=app_
NEXT_PUBLIC_WORLD_ACTION=cpay-recipient-v1
# "staging" only with the simulator; "production" for real World App users
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
WORLD_ENVIRONMENT=staging
WORLD_RP_ID=rp_
# Secret. Server-side only (issuer), used by signRequest from @worldcoin/idkit-core/signing
WORLD_RP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# World: Agent Pass (OIDC step-up for over-cap payments)
# Validated by the payer's own route handler (apps/web/app/api/agent-pass/*), NOT the issuer.
# Docs: https://auth.world.org/docs/guides/human-in-the-loop
# ---------------------------------------------------------------------------
AGENT_PASS_ISSUER=https://auth.world.org
AGENT_PASS_CLIENT_ID=
AGENT_PASS_CLIENT_SECRET=
AGENT_PASS_REDIRECT_URI=http://localhost:3000/api/agent-pass/callback
AGENT_PASS_ACR=https://world.org/oidc/acr/orb

# ---------------------------------------------------------------------------
# Issuer (apps/issuer): stores exactly three things: used nullifiers, the World RP signing key, the BBS issuer secret key. Nothing else.
# ---------------------------------------------------------------------------
ISSUER_PORT=8788
ISSUER_DB_PATH=./data/issuer.sqlite
# Secret. BBS issuer secret key (hex). Generate with `pnpm --filter @cpay/issuer keygen`
ISSUER_BBS_SECRET_KEY=
# CORS: the web app origin(s), comma-separated
ISSUER_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_ISSUER_URL=http://localhost:8788

# ---------------------------------------------------------------------------
# 0G Private Computer (router). Server-side only (apps/web/app/api/*)
# OpenAPI: https://0gfoundation.github.io/0g-router/   Models: https://pc.0g.ai/models
# ---------------------------------------------------------------------------
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# Secret
ZG_ROUTER_API_KEY=sk-
# Sent as the X-0G-Provider-Trust-Mode header. Must be "private" for speech-to-text + intent.
ZG_TRUST_MODE=private
# Ears (speech-to-text, private mode)
ZG_STT_MODEL=whisper-large-v3
# Brain (intent -> {amount, token}, private mode)
ZG_INTENT_MODEL=glm-5.3
# Voice (TTS of fixed template replies). TTS models are NOT private-mode, so only template text is ever sent.
# Confirm the ID + voice with GET /v1/models -> speech_capabilities.voices
ZG_TTS_MODEL=minimax-speech-2.8-turbo
ZG_TTS_VOICE=
ZG_TTS_TRUST_MODE=verified
ZG_TTS_FORMAT=mp3
# Safe-stop if 0G doesn't answer within this many ms
ZG_TIMEOUT_MS=8000
# 0G evidence: request IDs + receipts for every call (0G asked to see these). Append-only JSONL, git-ignored (data/).
ZG_EVIDENCE_PATH=./data/zerog-evidence.jsonl

# ---------------------------------------------------------------------------
# 0G Storage (episode log), Galileo testnet. Faucet: https://faucet.0g.ai
# ---------------------------------------------------------------------------
ZG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# Secret. Throwaway Galileo key that pays for uploads
ZG_STORAGE_PRIVATE_KEY=0x

# Optional iAI bonus: sign in with a 0G account (Privy app ID from 0G; localhost:3000/3001/5173 only)
NEXT_PUBLIC_ZG_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# Face matching (same model + preprocessing on both sides)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FACE_MATCH_THRESHOLD=0.6
NEXT_PUBLIC_CLAIM_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Glasses bridge (packages/glasses-kit/bridge), on the payer laptop
# Wi-Fi credentials for the ESP32 go in packages/glasses-kit/firmware/include/secrets.h (git-ignored)
# Voice uses Bluetooth earbuds paired to this laptop; select them as the browser mic + speaker.
# ---------------------------------------------------------------------------
BRIDGE_HTTP_PORT=8790
BRIDGE_WS_PORT=8791
NEXT_PUBLIC_BRIDGE_WS_URL=ws://localhost:8791
